# Supabase project (see supabase/ for schema + migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — used for signed digital-file
# URLs and granting book access after a confirmed payment. Must be the
# legacy service_role JWT (Project Settings > API > service_role) — the
# newer "sb_secret_..." key does not carry bypass privilege on this
# project as of this writing.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — leave unset. Absent by design: no online payment gateway is
# configured for this project (see src/lib/payments/provider.ts). Setting
# it to a provider name (e.g. "mercadopago") only has any effect once a
# real PaymentProvider implementation is registered there — it does not
# invent an integration by itself. Until then, the checkout shows "Pagar
# online" as coming soon and only bank transfer is usable.
# PAYMENT_PROVIDER=
